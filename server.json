{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.AceDataCloud/mcp-seedance",
  "description": "Generate Seedance videos with Ace Data Cloud; retrieve the original task for finished video.",
  "version": "2026.3.19.7",
  "repository": {
    "url": "https://github.com/AceDataCloud/SeedanceMCP",
    "source": "github"
  },
  "packages": [
    {
      "identifier": "mcp-seedance",
      "version": "2026.3.19.7",
      "transport": {
        "type": "stdio"
      },
      "registryType": "pypi",
      "runtimeHint": "uvx",
      "environmentVariables": [
        {
          "name": "ACEDATACLOUD_API_TOKEN",
          "description": "API token from Ace Data Cloud (https://platform.acedata.cloud)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "websiteUrl": "https://platform.acedata.cloud/documents/seedance-mcp?utm_source=mcp_registry&utm_medium=referral&utm_campaign=evergreen&utm_content=seedance_mcp_listing_guide",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://seedance.mcp.acedata.cloud/mcp"
    }
  ],
  "title": "Seedance by Ace Data Cloud",
  "icons": [
    {
      "src": "https://cdn.acedata.cloud/9q90dl.png",
      "mimeType": "image/png"
    }
  ]
}
